{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "noUncheckedIndexedAccess": true, "esModuleInterop": true, "skipLibCheck": true,
    "resolveJsonModule": true, "jsx": "react-jsx", "noEmit": true,
    "types": ["node", "vitest/globals"]
  },
  "include": ["apps/**/*.ts", "apps/**/*.tsx", "packages/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts", "*.ts"],
  "exclude": ["**/node_modules", "**/.next", "**/dist"]
}
