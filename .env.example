DATABASE_URL=postgresql://nexus:nexus@127.0.0.1:55432/nexus
REDIS_URL=redis://127.0.0.1:56379
# Generate independent 32-byte hex secrets. Never use sample values in production.
IDENTITY_KEY=
LOOKUP_KEY=
COMPONENT_KEY=
DISCORD_PUBLIC_KEY=
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
NEXUS_INTERACTION_TRANSPORT=gateway
NEXUS_COMMAND_SCOPE=guild
NODE_ENV=development
# Only honored when NODE_ENV=development; leave empty otherwise.
NEXUS_DEV_PLAN=
API_KEY=
API_PORT=3001
INTERACTION_PORT=3002
# Optional read-only web overview (server-side configuration, never NEXT_PUBLIC).
NEXUS_API_URL=http://127.0.0.1:3001
NEXUS_ORGANIZATION_ID=
NEXUS_GUILD_ID=
NEXUS_API_TOKEN=
NEXUS_WEB_PASSWORD=
NEXUS_WEB_URL=http://localhost:3100
NEXUS_WEB_PORT=3100
NEXUS_WEB_AUTH_MODE=oauth
DISCORD_CLIENT_SECRET=
NEXUS_SESSION_SECRET=
# Hosted invitation admission; production always requires it. Only synthetic,
# nonproduction legacy fixtures may opt out. Do not expose the operator port.
NEXUS_HOSTED_BETA=on
NEXUS_OPERATOR_PORT=3210
NEXUS_OPERATOR_CREDENTIALS=.local/operator/credentials.json
# Defaults can be tightened, but these safety ceilings cannot be raised here.
NEXUS_OPERATOR_IDLE_SECONDS=900
NEXUS_OPERATOR_ABSOLUTE_SECONDS=28800
NEXUS_OPERATOR_MAX_FAILURES=5
NEXUS_OPERATOR_FAILURE_WINDOW_SECONDS=900
NEXUS_PUBLIC_IDLE_SECONDS=43200
NEXUS_PUBLIC_ABSOLUTE_SECONDS=604800
# Owner supplies this independently, locally; never paste a real key into chat.
NEXUS_TOMBSTONE_KEY=
# Set to 1 only in an isolated, offline restore before admitting any traffic.
NEXUS_RESTORE_OFFLINE=0
NEXUS_FEEDBACK_URL=
# Optional build SHA override for packaged deployments.
NEXUS_BUILD_SHA=
NEXT_TELEMETRY_DISABLED=1
# Commercial features are opt-in; no real checkout is configured by these defaults.
NEXUS_INTERNAL_ADMIN_IDS=
NEXUS_DISCORD_BILLING_ENABLED=false
NEXUS_BILLING_DEVELOPER_COUNTRY=
NEXUS_DISCORD_MONETIZATION_APPROVED=false
NEXUS_DISCORD_SKU_STARTER=
NEXUS_DISCORD_SKU_GROWTH=
NEXUS_DISCORD_SKU_SCALE=

# Server-only Stripe configuration. Sandbox keys are rejected in production.
NEXUS_STRIPE_ENABLED=false
NEXUS_STRIPE_MODE=SANDBOX
STRIPE_SECRET_KEY=
# Publishable key only; passed with an intended Elements Checkout client secret.
STRIPE_PUBLISHABLE_KEY=
# ELEMENTS (default) or HOSTED fallback. Does not enable sales.
NEXUS_STRIPE_CHECKOUT_UI=ELEMENTS
NEXUS_STRIPE_CHECKOUT_ENABLED=false
NEXUS_STRIPE_PUBLIC_SALES_ENABLED=false
NEXUS_STRIPE_MANAGEMENT_ENABLED=true
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIGURATION_ID=
# Live billing remains disabled until every launch gate has been approved.
NEXUS_STRIPE_LIVE_ENABLED=false
NEXUS_PUBLIC_PRICES_APPROVED=false
NEXUS_DISCORD_PARITY_APPROVED=false
NEXUS_PAID_FEATURES_APPROVED=false
NEXUS_TAX_LEGAL_APPROVED=false
NEXUS_REFUND_POLICY_APPROVED=false
NEXUS_SUPPORT_POLICY_APPROVED=false
NEXUS_BILLING_MONITORING_APPROVED=false
NEXUS_BILLING_INCIDENT_HANDLING_APPROVED=false
NEXUS_BACKUP_RESTORE_APPROVED=false
