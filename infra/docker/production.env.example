# Non-secret settings only. Keep the configured copy outside this checkout.
# Empty values intentionally fail Compose interpolation. Do not put passwords here.
# Paths must identify owner-protected regular files outside the checkout.
NEXUS_PRODUCTION_POSTGRES_PASSWORD_FILE=
NEXUS_PRODUCTION_REDIS_ACL_FILE=
# Explicitly approve unless-stopped or bounded on-failure:N; see operations doc.
NEXUS_PRODUCTION_DATASTORE_RESTART_POLICY=
# All resource values require explicit approval; no measured profile is inferred.
# CPU: positive fractional count; memory/shm/log size: finite Compose byte sizes.
# PID/log-file counts: positive integers; Redis maxmemory: positive integer bytes.
# Do not use 0, -1, infinity, or other unlimited values.
NEXUS_PRODUCTION_PG_CPUS=
NEXUS_PRODUCTION_PG_MEMORY=
NEXUS_PRODUCTION_PG_PIDS=
NEXUS_PRODUCTION_PG_SHM_SIZE=
NEXUS_PRODUCTION_REDIS_CPUS=
NEXUS_PRODUCTION_REDIS_MEMORY=
NEXUS_PRODUCTION_REDIS_PIDS=
NEXUS_PRODUCTION_REDIS_MAXMEMORY_BYTES=
NEXUS_PRODUCTION_LOG_MAX_SIZE=
NEXUS_PRODUCTION_LOG_MAX_FILES=
